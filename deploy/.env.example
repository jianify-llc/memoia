# /opt/memoia/.env, root:root 0600. Init creates missing templates only.
# Fill values manually; daily publication never overwrites this file.
JIANIFY_ENV=
COMPOSE_PROJECT_NAME=
MEMOIA_DATA_ROOT=/opt/memoia/data
MEMOIA_IMAGE=
POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f
REDIS_IMAGE=redis:7.4@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f
POSTGRES_USER=memoia
POSTGRES_DB=memoia
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# URL-encode passwords when composing URLs. Hostnames are Compose service names.
DATABASE_URL=
REDIS_URL=
ACCESS_TOKEN=
PROJECT_ID=
MEMOBASE_LLM_API_KEY=
MEMOBASE_EMBEDDING_API_KEY=
# Provider, endpoint, models and processing settings live in api/config.yaml.
API_HOSTS=
