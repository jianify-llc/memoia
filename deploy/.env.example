# /opt/memoia/.env, root:root 0600. Init creates missing templates only.
# Fill values manually; daily publication never overwrites this file.
JIANIFY_ENV=
COMPOSE_PROJECT_NAME=
MEMOIA_DATA_ROOT=/opt/memoia/data
MEMOIA_IMAGE=
REDIS_IMAGE=redis:7.4@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f
REDIS_PASSWORD=
# URL-encode the database password. PostgreSQL is managed at /opt/postgres;
# its private-network alias is jianify-postgres. Redis remains in this Compose.
DATABASE_URL=
REDIS_URL=
# Per API/Worker process. Pool exhaustion fails fast; no implicit command replay.
REDIS_MAX_CONNECTIONS=32
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=2
ACCESS_TOKEN=
PROJECT_ID=
MEMOBASE_LLM_API_KEY=
MEMOBASE_EMBEDDING_API_KEY=
# Provider, endpoint, models and processing settings live in api/config.yaml.
API_HOSTS=
