{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memoia",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "env": {
    "test": {
      "name": "luvel-memoia-test",
      "secrets": { "required": ["ACCESS_TOKEN", "OPENAI_API_KEY"] },
      "vars": { "MAINTENANCE_ENABLED": "false", "MEMOIA_WRITES_ENABLED": "false" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "fd98a84c954446b4afc1b1311d35fb28" }],
      "queues": {
        "producers": [{ "binding": "MAINTENANCE_QUEUE", "queue": "luvel-memoia-maintenance-test" }],
        "consumers": [{ "queue": "luvel-memoia-maintenance-test", "max_batch_size": 1, "max_concurrency": 4, "max_retries": 3 }]
      },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
